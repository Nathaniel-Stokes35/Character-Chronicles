@inherits LayoutComponentBase

<div class="site-layout">
    <NavMenu />

    <main class="site-content">
        @Body
    </main>
</div>

<div id="blazor-error-ui"
     data-nosnippet>
    An unhandled error has occurred.

    <a href="."
       class="reload">
        Reload
    </a>

    <button type="button"
            class="dismiss"
            aria-label="Dismiss error message">
        ×
    </button>
</div>