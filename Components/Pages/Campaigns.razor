@page "/campaigns"

<PageTitle>Campaigns | Character Chronicles</PageTitle>

<section class="holder-page campaigns-page">
    <div class="holder-symbol"
         aria-hidden="true">
        20
    </div>

    <div class="holder-shell">
        <p class="holder-eyebrow">
            The Campaign Archive
        </p>

        <h1>
            Your Next Great Campaign
            <br />
            <span>Is Being Prepared</span>
        </h1>

        <p class="holder-intro">
            The campaign manager is still being forged. Soon you will
            be able to organise adventures, connect heroes, and keep
            every chapter of your party's story in one place.
        </p>

        <div class="holder-card-grid">
            <article class="holder-card">
                <i class="fa-solid fa-book-open"
                   aria-hidden="true"></i>

                <h2>Create Campaigns</h2>

                <p>
                    Set up a new adventure with its own title,
                    setting, notes, and current status.
                </p>
            </article>

            <article class="holder-card">
                <i class="fa-solid fa-users"
                   aria-hidden="true"></i>

                <h2>Gather Your Party</h2>

                <p>
                    Assign saved characters to campaigns and keep
                    the whole adventuring group together.
                </p>
            </article>

            <article class="holder-card">
                <i class="fa-solid fa-scroll"
                   aria-hidden="true"></i>

                <h2>Record the Journey</h2>

                <p>
                    Return to old adventures and review the important
                    events from every campaign.
                </p>
            </article>
        </div>

        <div class="holder-actions">
            <a class="holder-primary"
               href="/characters">
                View Characters
            </a>

            <a class="holder-secondary"
               href="/">
                Return Home
            </a>
        </div>
    </div>
</section>