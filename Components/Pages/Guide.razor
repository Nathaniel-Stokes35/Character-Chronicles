@page "/guide"


<section class="holder-page about-page">

    <div class="holder-symbol"
         aria-hidden="true">
        CC
    </div>

    <div class="holder-shell about-shell">

        <div class="about-copy">

            <p class="holder-eyebrow">
                Character Chronicles User Guide
            </p>

            <h1>
                Begin Your
                <br />
                <span>Next Chronicle</span>
            </h1>

            <p class="holder-intro">
                Character Chronicles helps you create and organize
                your Dungeons & Dragons characters and campaigns.
                This guide covers the basic features you need to
                begin using the application.
            </p>

            <div class="about-values">

                <article>
                    <i class="fa-solid fa-user-shield"
                       aria-hidden="true"></i>

                    <div>
                        <h2>Sign In First</h2>

                        <p>
                            Sign in to your Character Chronicles
                            account before creating characters or
                            campaigns. Your characters and campaigns
                            are associated with your account.
                        </p>
                    </div>
                </article>

                <article>
                    <i class="fa-solid fa-compass"
                       aria-hidden="true"></i>

                    <div>
                        <h2>Navigate Your Chronicle</h2>

                        <p>
                            Use the application navigation to open
                            your character library, manage campaigns,
                            and return to your saved adventures.
                        </p>
                    </div>
                </article>

            </div>

            <a class="holder-primary"
               href="/characters">
                Open Character Library
            </a>

        </div>

        <aside class="about-panel">

            <div class="about-rings"
                 aria-hidden="true">
            </div>

            <i class="fa-solid fa-book-open"
               aria-hidden="true"></i>

            <strong>
                User Guide
            </strong>

            <span>
                Your adventure starts here
            </span>

        </aside>

    </div>

    <div class="holder-shell about-details">

        <section class="about-detail-section">

            <p class="holder-eyebrow">
                Creating a Character
            </p>

            <h2>
                Build and save your hero
            </h2>

            <div class="feature-grid">

                <article class="feature-card">
                    <i class="fa-solid fa-user-plus"
                       aria-hidden="true"></i>

                    <h3>1. Create a Character</h3>

                    <p>
                        Open the Character Library and select
                        Create Character. Enter your character's
                        name, ancestry, class, level, type,
                        status, and optional campaign.
                    </p>
                </article>

                <article class="feature-card">
                    <i class="fa-solid fa-dice"
                       aria-hidden="true"></i>

                    <h3>2. Roll Ability Scores</h3>

                    <p>
                        Select Roll Stats to generate six ability
                        scores. Each score uses 4d6 with the lowest
                        die discarded. Assign one rolled result to
                        Strength, Dexterity, Constitution,
                        Intelligence, Wisdom, and Charisma.
                    </p>
                </article>

                <article class="feature-card">
                    <i class="fa-solid fa-floppy-disk"
                       aria-hidden="true"></i>

                    <h3>3. Save the Character</h3>

                    <p>
                        When the required information and ability
                        scores are complete, save the character.
                        The character will be added to your
                        personal character library.
                    </p>
                </article>

            </div>

        </section>

        <section class="about-detail-section">

            <p class="holder-eyebrow">
                Character Library
            </p>

            <h2>
                Return to your adventurers anytime
            </h2>

            <div class="feature-grid">

                <article class="feature-card">
                    <i class="fa-solid fa-address-book"
                       aria-hidden="true"></i>

                    <h3>Browse Characters</h3>

                    <p>
                        The Character Library displays the characters
                        associated with your account. Use the available
                        search, status, and sorting controls to locate
                        a specific character.
                    </p>
                </article>

                <article class="feature-card">
                    <i class="fa-solid fa-scroll"
                       aria-hidden="true"></i>

                    <h3>Open a Character Sheet</h3>

                    <p>
                        Select a character to open the character
                        sheet. From here you can review or edit
                        character information such as level,
                        hit points, background, personality,
                        equipment, and traits.
                    </p>
                </article>

                <article class="feature-card">
                    <i class="fa-solid fa-pen"
                       aria-hidden="true"></i>

                    <h3>Edit or Delete</h3>

                    <p>
                        Save changes after editing a character.
                        Characters you no longer need can also
                        be removed from your library.
                    </p>
                </article>

            </div>

        </section>

        <section class="about-detail-section">

            <p class="holder-eyebrow">
                Campaigns
            </p>

            <h2>
                Organize characters into adventures
            </h2>

            <div class="feature-grid">

                <article class="feature-card">
                    <i class="fa-solid fa-dungeon"
                       aria-hidden="true"></i>

                    <h3>Create a Campaign</h3>

                    <p>
                        Open Campaigns and select New Campaign.
                        Enter the campaign name, setting, game
                        system, schedule, status, description,
                        and any private Dungeon Master notes.
                    </p>
                </article>

                <article class="feature-card">
                    <i class="fa-solid fa-users"
                       aria-hidden="true"></i>

                    <h3>Add Players</h3>

                    <p>
                        When creating a campaign, you can select
                        available friends and add them as players.
                        Joined campaigns appear separately from
                        campaigns you created.
                    </p>
                </article>

                <article class="feature-card">
                    <i class="fa-solid fa-link"
                       aria-hidden="true"></i>

                    <h3>Assign Characters</h3>

                    <p>
                        When creating a character, select one of
                        the campaigns available to your account.
                        You can use campaigns you created or
                        campaigns you have joined.
                    </p>
                </article>

            </div>

        </section>

        <section class="about-detail-section">

            <p class="holder-eyebrow">
                Helpful Tips
            </p>

            <h2>
                A few things to remember
            </h2>

            <div class="feature-grid">

                <article class="feature-card">
                    <i class="fa-solid fa-key"
                       aria-hidden="true"></i>

                    <h3>Your Data Is Account Based</h3>

                    <p>
                        Characters and campaigns are associated
                        with the account that created or joined
                        them. Make sure you are signed into the
                        correct account when looking for saved data.
                    </p>
                </article>

                <article class="feature-card">
                    <i class="fa-solid fa-arrows-rotate"
                       aria-hidden="true"></i>

                    <h3>Your Data Is Persistent</h3>

                    <p>
                        Saved characters and campaigns are stored
                        in the application's database and will
                        remain available after you leave or
                        refresh the application.
                    </p>
                </article>

                <article class="feature-card">
                    <i class="fa-solid fa-dice-d20"
                       aria-hidden="true"></i>

                    <h3>Duplicate Rolls Are Allowed</h3>

                    <p>
                        Two ability rolls may have the same numeric
                        value. They are still separate rolled results
                        and can each be assigned to a different
                        ability score.
                    </p>
                </article>

            </div>

        </section>

        <section class="about-detail-section roadmap-section">

            <p class="holder-eyebrow">
                Ready to Begin?
            </p>

            <h2>
                Start your next character
            </h2>

            <p>
                Visit your Character Library to create a new
                adventurer, or open Campaigns to begin organizing
                your next adventure.
            </p>

            <div style="display: flex; gap: 1rem; flex-wrap: wrap;">

                <a class="holder-primary"
                   href="/characters">
                    Characters
                </a>

                <a class="holder-primary"
                   href="/campaigns">
                    Campaigns
                </a>

            </div>

        </section>

    </div>

</section>