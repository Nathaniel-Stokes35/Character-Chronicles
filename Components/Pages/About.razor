@page "/about"

<PageTitle>About | Character Chronicles</PageTitle>

<section class="holder-page about-page">
    <div class="holder-symbol"
         aria-hidden="true">
        CC
    </div>

    <div class="holder-shell about-shell">
        <div class="about-copy">
            <p class="holder-eyebrow">
                About the Chronicle
            </p>

            <h1>
                Every Hero Deserves
                <br />
                <span>A Story Worth Keeping</span>
            </h1>

            <p class="holder-intro">
                Character Chronicles is a tabletop role-playing
                companion designed to keep characters, campaigns,
                and future adventures organised without losing the
                feeling of a handwritten fantasy archive.
            </p>

            <div class="about-values">
                <article>
                    <i class="fa-solid fa-shield-halved"
                       aria-hidden="true"></i>

                    <div>
                        <h2>Built for Players</h2>

                        <p>
                            Keep several heroes ready for different
                            groups, systems, and ongoing stories.
                        </p>
                    </div>
                </article>

                <article>
                    <i class="fa-solid fa-compass"
                       aria-hidden="true"></i>

                    <div>
                        <h2>Designed to Grow</h2>

                        <p>
                            The application is structured so more
                            campaign tools and RPG systems can be
                            added later.
                        </p>
                    </div>
                </article>
            </div>

            <a class="holder-primary"
               href="/characters">
                Explore Characters
            </a>
        </div>

        <aside class="about-panel">
            <div class="about-rings"
                 aria-hidden="true">
            </div>

            <i class="fa-solid fa-dice-d20"
               aria-hidden="true"></i>

            <strong>
                Character Chronicles
            </strong>

            <span>
                Every hero has a story
            </span>
        </aside>
    </div>
</section>